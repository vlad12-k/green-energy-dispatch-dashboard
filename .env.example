APP_NAME=green-energy-dispatch-dashboard
# Defaults are production-safe; set DEBUG=true only for trusted local development.
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Local defaults preserve the full API; render.yaml enables public demo mode.
SIMULATION_ONLY_MODE=false
SERVE_FRONTEND=false
MAX_REQUEST_BODY_BYTES=65536
# Per-process rolling window; use an edge limiter if deploying multiple replicas.
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# NESO Carbon Intensity API
NESO_API_BASE_URL=https://api.carbonintensity.org.uk
NESO_REGION_ID=13
NESO_MAX_AGE_SECONDS=3600
NESO_TIMEOUT_SECONDS=5

# Optional PostgreSQL development service. Leave unset to preserve stateless API behaviour.
# Before enabling the separate database Compose file, set a strong local-only password:
# POSTGRES_PASSWORD=<unique-local-password>
# Set DATABASE_URL using that same password; URL-encode reserved characters.
# For API-to-database Compose connections, use the internal hostname db:5432.
# DATABASE_URL=postgresql+psycopg://ged:<URL-encoded-password>@db:5432/ged

# Standalone NESO collector (disabled by default; migrations remain explicit).
# COLLECTOR_ENABLED=false
# COLLECTOR_INTERVAL_SECONDS=1800
# COLLECTOR_MAX_ATTEMPTS=3
# COLLECTOR_BACKOFF_BASE_SECONDS=5
# COLLECTOR_BACKOFF_MAX_SECONDS=60
